// ============================================================
// RV32I branch & jump edge case test
// $readmemh compatible — one 32-bit word per line
//
// Pass condition : x10 = 24, PC stuck at HALT
// Fail condition : PC stuck at a FAIL trap (JAL x0,0)
//                  The pc value tells you exactly which test failed
//
// Register usage:
//   x0  = zero (hardwired)
//   x1  = link register (JAL/JALR)
//   x5  = scratch a
//   x6  = scratch b
//   x7  = expected value
//   x10 = pass counter (24 = all passed)
//
// FAIL trap addresses (PC stuck here = that test failed):
//   pc=0x010  [004]  FAIL T1 BEQ taken: stuck here if reached (pc=0x010)
//   pc=0x02C  [011]  FAIL T2 BEQ not-taken: stuck here if reached (pc=0x02C)
//   pc=0x03C  [015]  FAIL T3 BNE taken: stuck here if reached (pc=0x03C)
//   pc=0x058  [022]  FAIL T4 BNE not-taken: stuck here if reached (pc=0x058)
//   pc=0x068  [026]  FAIL T5 BLT taken: stuck here if reached (pc=0x068)
//   pc=0x084  [033]  FAIL T6 BLT not-taken: stuck here if reached (pc=0x084)
//   pc=0x094  [037]  FAIL T7 BLT signed -1<1: stuck here if reached (pc=0x094)
//   pc=0x0B0  [044]  FAIL T8 BLT signed 1>-1: stuck here if reached (pc=0x0B0)
//   pc=0x0C8  [050]  FAIL T9 BLTU 0xFFFF>1: stuck here if reached (pc=0x0C8)
//   pc=0x0D8  [054]  FAIL T10 BLTU 1<0xFFFF: stuck here if reached (pc=0x0D8)
//   pc=0x0EC  [059]  FAIL T11 BGE equal: stuck here if reached (pc=0x0EC)
//   pc=0x100  [064]  FAIL T12 BGE greater: stuck here if reached (pc=0x100)
//   pc=0x11C  [071]  FAIL T13 BGE not-taken: stuck here if reached (pc=0x11C)
//   pc=0x134  [077]  FAIL T14 BGE signed: stuck here if reached (pc=0x134)
//   pc=0x144  [081]  FAIL T15 BGEU: stuck here if reached (pc=0x144)
//   pc=0x154  [085]  FAIL T16 BEQ x0: stuck here if reached (pc=0x154)
